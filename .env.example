# Supabase (the service role key is server-only)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public site address, e.g. https://example.com (no trailing slash)
SITE_URL=

# Order emails go to ADMIN_EMAIL, and to NOTIFY_EMAIL as well when it is set
ADMIN_EMAIL=
NOTIFY_EMAIL=

# Email sending, option 1: Gmail with an app password (reaches you and your customers)
SMTP_USER=
SMTP_PASSWORD=

# Email sending, option 2: Resend. EMAIL_FROM needs a domain verified in Resend;
# without it Resend only delivers to the Resend account owner.
RESEND_API_KEY=
EMAIL_FROM=

# WhatsApp order alerts to your own phone (see README)
WHATSAPP_NOTIFY_NUMBER=
CALLMEBOT_API_KEY=
# Or Meta's official WhatsApp Cloud API
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE=
WHATSAPP_TEMPLATE_LANGUAGE=
